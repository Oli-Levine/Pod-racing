{
  "name": "pod-racing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Couch multiplayer hover-pod racing. TV browser runs the game, phones are controllers.",
  "scripts": {
    "dev": "node net/server.js",
    "build": "vite build",
    "start": "vite build && node net/server.js --prod",
    "serve": "node net/server.js --prod",
    "sim": "node scripts/sim-phones.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
